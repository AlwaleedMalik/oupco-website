---
import Layout from "../../layouts/Layout.astro";
import PageHeader from "../../components/PageHeader.astro";
import SectionHeading from "../../components/SectionHeading.astro";
import Icon from "../../components/Icon.astro";
import Button from "../../components/Button.astro";
import Field from "../../components/Field.astro";
import FormEnhance from "../../components/FormEnhance.astro";
import Honeypot from "../../components/Honeypot.astro";
import LogoWall from "../../components/LogoWall.astro";
import { site } from "../../data/site";
import { suppliers } from "../../data/logos";
import { en, getT, langPaths, options } from "../../i18n";

export function getStaticPaths() {
  return langPaths();
}

const t = getT(Astro.url);
const p = t.pages.supplier;
const f = t.forms;

// Saved values stay English; labels follow the page language
const catValues = [...en.products.map((x) => x.title), ...en.services.map((x) => x.title), ...en.lists.extraCategories];
const catLabels = [...t.products.map((x) => x.title), ...t.services.map((x) => x.title), ...t.lists.extraCategories];
const categories = options(catValues, catLabels);
const regions = options(en.lists.regions, t.lists.regions);
const localOptions = [
  { value: "true", icon: "flag", ...p.local.yes },
  { value: "false", icon: "ship", ...p.local.no, badge: "" },
];
---

<Layout title={p.title} description={p.description}>
  <PageHeader eyebrow={p.header.eyebrow} title={p.header.title} text={p.header.text}>
    <div class="mt-8 flex flex-wrap gap-3">
      <Button href="#apply" variant="secondary" size="lg" icon="arrow-down">{p.applyCta}</Button>
      <Button href="#criteria" variant="outline-light" size="lg">{p.seeReq}</Button>
    </div>
  </PageHeader>

  <!-- BENEFITS — Relume Layout 239 -->
  <section class="px-[5%] py-16 md:py-24 lg:py-28">
    <div class="container">
      <SectionHeading eyebrow={p.benefits.eyebrow} title={p.benefits.title} class="mb-12 md:mb-16" />
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {t.supplierBenefits.map((b, i) => (
          <article class="rounded-card border border-line bg-white p-6 transition-shadow duration-200 hover:shadow-lift md:p-7" data-reveal style={`--reveal-delay:${i * 60}ms`}>
            <span class="flex size-12 items-center justify-center rounded-xl bg-teal-100 text-teal-700"><Icon name={b.icon} /></span>
            <h3 class="mt-6 text-h6">{b.title}</h3>
            <p class="mt-2 text-small text-muted">{b.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- CRITERIA + STEPS -->
  <section id="criteria" class="bg-canvas px-[5%] py-16 md:py-24 lg:py-28">
    <div class="container grid gap-12 lg:grid-cols-2 lg:gap-20">
      <div>
        <SectionHeading eyebrow={p.criteria.eyebrow} title={p.criteria.title} text={p.criteria.text} />
        <ul class="mt-8 space-y-3" data-reveal>
          {t.supplierCriteria.map((c) => (
            <li class="flex items-start gap-3 rounded-button bg-white p-4 ring-1 ring-line">
              <Icon name="circle-check" size={22} class="mt-px shrink-0 text-teal-600" />
              <span class="text-navy-900">{c}</span>
            </li>
          ))}
        </ul>
      </div>
      <div>
        <SectionHeading eyebrow={p.process.eyebrow} title={p.process.title} />
        <ol class="mt-8 space-y-0">
          {t.supplierSteps.map((s, i) => (
            <li class="relative flex gap-5 pb-8 last:pb-0" data-reveal style={`--reveal-delay:${i * 70}ms`}>
              {i < t.supplierSteps.length - 1 && <span class="absolute start-6 top-12 bottom-0 w-px bg-line-strong" aria-hidden="true"></span>}
              <span class="relative z-10 flex size-12 shrink-0 items-center justify-center rounded-full bg-navy-900 font-display font-semibold text-white">{i + 1}</span>
              <div class="pt-2.5">
                <h3 class="text-h6">{s.title}</h3>
                <p class="mt-1 text-muted">{s.text}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <!-- CURRENT SUPPLIERS -->
  <section class="px-[5%] pt-16 md:pt-24">
    <div class="container">
      <h2 class="mb-8 text-center font-display text-small font-semibold uppercase tracking-[0.12em] text-muted">{p.network}</h2>
      <LogoWall logos={suppliers} cols="grid-cols-2 sm:grid-cols-3 lg:grid-cols-6">
        <li class="flex h-24 items-center justify-center rounded-card bg-navy-900 px-4 text-center font-display text-small font-medium text-white md:h-28">{t.ui.hundredsMore}</li>
      </LogoWall>
    </div>
  </section>

  <!-- APPLICATION FORM — Relume Contact 1 / Multi-step simplified to one step -->
  <section id="apply" class="px-[5%] py-16 md:py-24 lg:py-28">
    <div class="container max-w-4xl">
      <SectionHeading eyebrow={p.form.eyebrow} title={p.form.title} text={p.form.text} align="center" class="mb-10 md:mb-12" />
      <div class="rounded-[1.5rem] bg-white p-6 shadow-lift ring-1 ring-line md:p-10">
        <form data-enhance data-table="supplier_applications" method="post" class="relative grid gap-5 sm:grid-cols-2">
          <Honeypot />
          <fieldset class="contents">
            <legend class="font-display text-h6 font-semibold text-navy-900 sm:col-span-2">{f.company}</legend>
            <Field name="company" label={f.companyName} rule="company" required autocomplete="organization" class="sm:col-span-2" />
            <Field name="cr" label={f.cr} rule="cr" required placeholder={f.crPlaceholder} helper={f.crHelp} />
            <Field name="vat" label={f.vat} rule="vat" placeholder="3XXXXXXXXXXXXX3" helper={f.vatHelp} />
            <Field name="category" label={p.category} type="select" required options={categories} />
            <Field name="region" label={p.region} type="select" required options={regions} />
            <fieldset class="sm:col-span-2" data-field aria-describedby="f-local_content-help f-local_content-err">
              <legend class="mb-1 font-display text-small font-medium text-navy-900">
                {p.local.question}<span class="text-error" aria-hidden="true"> *</span>
              </legend>
              <p id="f-local_content-help" class="mb-3 text-small text-muted">{p.local.help}</p>
              <div class="grid gap-3 sm:grid-cols-2">
                {localOptions.map((o) => (
                  <label class="group relative flex cursor-pointer gap-4 rounded-card border-2 border-line bg-white p-4 transition-[border-color,background-color,box-shadow] duration-200 hover:border-teal-600/40 has-[:checked]:border-teal-600 has-[:checked]:bg-teal-50 has-[:focus-visible]:ring-4 has-[:focus-visible]:ring-teal-600/20 md:p-5">
                    <input type="radio" name="local_content" value={o.value} required class="peer sr-only" />
                    <span class="flex size-11 shrink-0 items-center justify-center rounded-xl bg-canvas text-muted transition-colors duration-200 group-has-[:checked]:bg-teal-600 group-has-[:checked]:text-white">
                      <Icon name={o.icon} size={22} />
                    </span>
                    <span class="min-w-0 flex-1 pe-6">
                      <span class="flex flex-wrap items-center gap-2 font-display font-semibold text-navy-900">
                        {o.title}
                        {o.badge && <span class="rounded-full bg-success/10 px-2 py-0.5 text-[0.75rem] font-semibold text-success">{o.badge}</span>}
                      </span>
                      <span class="mt-1 block text-small text-muted">{o.text}</span>
                    </span>
                    <span class="absolute end-4 top-4 flex size-5 items-center justify-center rounded-full border-2 border-line-strong transition-colors duration-200 group-has-[:checked]:border-teal-600 group-has-[:checked]:bg-teal-600 group-has-[:checked]:text-white" aria-hidden="true">
                      <Icon name="check" size={12} strokeWidth={3} class="opacity-0 group-has-[:checked]:opacity-100" />
                    </span>
                  </label>
                ))}
              </div>
              <p id="f-local_content-err" class="mt-1.5 hidden text-small font-medium text-error" data-error></p>
            </fieldset>
            <Field name="website" label={f.website} rule="website" placeholder="company.com" autocomplete="url" class="sm:col-span-2" />
          </fieldset>
          <fieldset class="contents">
            <legend class="mt-4 border-t border-line pt-6 font-display text-h6 font-semibold text-navy-900 sm:col-span-2">{f.contactPerson}</legend>
            <Field name="name" label={f.fullName} rule="name" required autocomplete="name" />
            <Field name="role" label={f.jobTitle} rule="jobTitle" autocomplete="organization-title" />
            <Field name="email" label={f.workEmail} type="email" rule="email" required autocomplete="email" />
            <Field name="phone" label={f.mobile} type="phone-sa" required helper={f.mobileHelp} />
            <Field name="about" label={p.about} type="textarea" rule="longText" rows={4} class="sm:col-span-2" />
          </fieldset>
          <p class="hidden rounded-button bg-error/10 p-3 text-small text-error sm:col-span-2" data-form-error role="alert">
            {f.errorBefore} <a href={`mailto:${site.email}`} class="font-semibold underline underline-offset-2" dir="ltr">{site.email}</a>.
          </p>
          <div class="flex flex-wrap items-center gap-4 sm:col-span-2">
            <button type="submit" class="inline-flex min-h-13 cursor-pointer items-center gap-2 rounded-button bg-teal-600 px-7 font-display font-medium text-white shadow-card transition-colors duration-200 hover:bg-teal-700 disabled:cursor-wait disabled:opacity-70">
              {p.submit} <Icon name="send" size={18} />
            </button>
            <p class="text-small text-muted">{p.docsNote}</p>
          </div>
        </form>
        <div data-success hidden tabindex="-1" class="py-10 text-center outline-none" role="status">
          <span class="mx-auto flex size-16 items-center justify-center rounded-full bg-success/10 text-success"><Icon name="circle-check" size={32} /></span>
          <h2 class="mt-6 text-h4">{p.successTitle}</h2>
          <p class="mx-auto mt-2 max-w-sm text-muted">{p.successText}</p>
        </div>
      </div>
    </div>
  </section>
  <FormEnhance />
</Layout>
