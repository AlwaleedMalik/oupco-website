---
import Layout from "../../layouts/Layout.astro";
import PageHeader from "../../components/PageHeader.astro";
import SectionHeading from "../../components/SectionHeading.astro";
import Icon from "../../components/Icon.astro";
import Button from "../../components/Button.astro";
import NumberedSteps from "../../components/NumberedSteps.astro";
import CtaBanner from "../../components/CtaBanner.astro";
import ArcMotif from "../../components/ArcMotif.astro";
import { site } from "../../data/site";
import { getLang, getT, langPaths, localizer } from "../../i18n";

export function getStaticPaths() {
  return langPaths();
}

const t = getT(Astro.url);
const p = t.pages.events;
const l = localizer(getLang(Astro.url));
---

<Layout title={p.title} description={p.description}>
  <PageHeader eyebrow={p.header.eyebrow} title={p.header.title} text={p.header.text}>
    <div class="mt-8 flex flex-wrap gap-3">
      <Button href="/apply" variant="secondary" size="lg" icon="arrow-right">{t.ui.applyNow}</Button>
      <Button href={site.loginUrl} variant="outline-light" size="lg">{t.ui.requestOnApp}</Button>
    </div>
  </PageHeader>

  <!-- EVENT TYPES -->
  <section class="px-[5%] py-16 md:py-24 lg:py-28">
    <div class="container">
      <SectionHeading eyebrow={p.types.eyebrow} title={p.types.title} class="mb-12 md:mb-16" />
      <div class="grid gap-4 md:grid-cols-3">
        {t.eventTypes.map((e, i) => (
          <article class="group flex flex-col rounded-card border border-line bg-white p-7 transition-shadow duration-200 hover:shadow-lift md:p-8" data-reveal style={`--reveal-delay:${i * 80}ms`}>
            <span class="flex size-14 items-center justify-center rounded-2xl bg-navy-900 text-white transition-colors duration-200 group-hover:bg-teal-600"><Icon name={e.icon} size={26} /></span>
            <h3 class="mt-6 text-h5">{e.title}</h3>
            <p class="mt-2 text-muted">{e.text}</p>
            <ul class="mt-6 space-y-2.5 border-t border-line pt-6">
              {e.items.map((it) => (
                <li class="flex items-center gap-2.5 text-small text-navy-900"><Icon name="check" size={16} class="shrink-0 text-teal-600" />{it}</li>
              ))}
            </ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- SERVICES (dark band) -->
  <section class="relative isolate overflow-hidden bg-navy-900 px-[5%] py-16 text-white md:py-24 lg:py-28">
    <ArcMotif class="pointer-events-none absolute -end-60 -bottom-60 -z-10 w-[40rem] opacity-60" dark="#1b3c59" light="#154f6b" />
    <div class="container">
      <SectionHeading eyebrow={p.services.eyebrow} title={p.services.title} text={p.services.text} tone="dark" class="mb-12 md:mb-16" />
      <ul class="grid gap-px overflow-hidden rounded-card bg-white/10 sm:grid-cols-2 lg:grid-cols-3">
        {t.eventServices.map((s, i) => (
          <li class="bg-navy-900 p-6 transition-colors duration-200 hover:bg-navy-800 md:p-7" data-reveal style={`--reveal-delay:${(i % 3) * 60}ms`}>
            <Icon name={s.icon} class="text-teal-300" />
            <h3 class="mt-5 text-h6 text-white">{s.title}</h3>
            <p class="mt-2 text-small text-white/65">{s.text}</p>
            {s.href && (
              <a href={l(s.href)} class="mt-3 inline-flex min-h-11 items-center gap-1.5 font-display text-small font-medium text-teal-300 hover:text-white">
                {p.explorePrinting} <Icon name="arrow-right" size={16} />
              </a>
            )}
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- PROCESS -->
  <section class="px-[5%] py-16 md:py-24 lg:py-28">
    <div class="container">
      <SectionHeading eyebrow={p.process.eyebrow} title={p.process.title} text={p.process.text} class="mb-12 md:mb-16" />
      <NumberedSteps steps={t.eventSteps} />
    </div>
  </section>

  <CtaBanner title={p.cta.title} text={p.cta.text} secondaryLabel={t.ui.requestOnApp} />
</Layout>
