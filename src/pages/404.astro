---
// One static 404 serves every missing URL, so it speaks both languages.
import Layout from "../layouts/Layout.astro";
import Button from "../components/Button.astro";
import ArcMotif from "../components/ArcMotif.astro";
import { en, ar } from "../i18n";

const e = en.pages.notFound;
const a = ar.pages.notFound;
---

<Layout title={`${e.title} · ${a.title}`} noindex>
  <section class="relative isolate overflow-hidden px-[5%] py-24 md:py-32">
    <ArcMotif class="pointer-events-none absolute -end-32 top-1/2 -z-10 w-[30rem] -translate-y-1/2 opacity-10" dark="#142e45" light="#195e7f" />
    <div class="container grid max-w-5xl gap-14 md:grid-cols-2 md:gap-16">
      <div lang="en" dir="ltr" class="text-left">
        <p class="font-display text-small font-semibold uppercase tracking-[0.12em] text-teal-600">{e.eyebrow}</p>
        <h1 class="mt-3 text-h2">{e.h1}</h1>
        <p class="mt-4 text-large text-muted">{e.text}</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <Button href="/" icon="arrow-right">{e.home}</Button>
          <Button href="/contact" variant="outline">{en.ui.contactUs}</Button>
        </div>
      </div>
      <div lang="ar" dir="rtl" class="text-right" style="font-family: var(--font-display); --font-display: 'Readex Pro', 'Lexend', sans-serif;">
        <p class="font-display text-small font-semibold text-teal-600">{a.eyebrow}</p>
        <p class="mt-3 font-display text-h2 font-semibold text-navy-900">{a.h1}</p>
        <p class="mt-4 text-large text-muted">{a.text}</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <Button href="/ar" icon="arrow-left">{a.home}</Button>
          <Button href="/ar/contact" variant="outline">{ar.ui.contactUs}</Button>
        </div>
      </div>
    </div>
  </section>
</Layout>
