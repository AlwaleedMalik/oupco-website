---
import Icon from "./Icon.astro";
import { getT } from "../i18n";

const { paymentModels } = getT(Astro.url);
---

<div class="mx-auto grid max-w-5xl gap-4 md:grid-cols-2">
  {paymentModels.map((m, i) => (
    <article class:list={["flex flex-col rounded-card p-8 md:p-10", i === 1 ? "bg-navy-900 text-white shadow-lift" : "border border-line bg-white"]} data-reveal style={`--reveal-delay:${i * 80}ms`}>
      <div class="flex items-center justify-between gap-4">
        <span class:list={["flex size-12 items-center justify-center rounded-xl", i === 1 ? "bg-teal-600 text-white" : "bg-teal-100 text-teal-700"]}><Icon name={m.icon} /></span>
        <span class:list={["rounded-full px-3 py-1 text-[0.8125rem] font-medium", i === 1 ? "bg-white/10 text-teal-300" : "bg-canvas text-muted"]}>{m.badge}</span>
      </div>
      <h3 class:list={["mt-6 text-h4", i === 1 && "text-white"]}>{m.title}</h3>
      <p class:list={["mt-3", i === 1 ? "text-white/75" : "text-muted"]}>{m.text}</p>
      <ul class="mt-6 space-y-3">
        {m.points.map((pt) => (
          <li class="flex items-start gap-3"><Icon name="check" size={20} class={i === 1 ? "mt-0.5 shrink-0 text-teal-300" : "mt-0.5 shrink-0 text-teal-600"} />{pt}</li>
        ))}
      </ul>
    </article>
  ))}
</div>
