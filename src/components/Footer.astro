---
// Layout ported from Relume Footer 3 (logo + contact details, link columns, legal row).
import Logo from "./Logo.astro";
import Icon from "./Icon.astro";
import { site, telHref } from "../data/site";
import { getLang, getT, localizer } from "../i18n";

const t = getT(Astro.url);
const f = t.ui.footer;
const lang = getLang(Astro.url);
const l = localizer(lang);
const comma = lang === "ar" ? "، " : ", ";
const year = new Date().getFullYear();
const columns = [
  {
    title: f.company,
    links: [
      { label: f.about, href: "/about" },
      { label: f.howItWorks, href: "/how-it-works" },
      { label: f.contact, href: "/contact" },
    ],
  },
  { title: f.solutions, links: t.solutions.map((s) => ({ label: s.label, href: s.href })) },
  {
    title: f.getStarted,
    links: [
      { label: f.applyAccount, href: "/apply" },
      { label: f.loginApp, href: site.loginUrl },
      { label: f.becomeSupplier, href: "/become-a-supplier" },
    ],
  },
];
---

<footer class="bg-navy-950 text-white/75">
  <div class="px-[5%]">
    <div class="container grid gap-12 py-16 md:py-20 lg:grid-cols-[1.1fr_2fr] lg:gap-20">
      <div>
        <a href={l("/")} aria-label={t.ui.home} class="inline-flex"><Logo tone="white" class="h-7 w-auto" /></a>
        <p class="mt-5 max-w-sm text-small text-white/65">
          <span dir="ltr">{t.company.fullName}</span>. {f.tagline}
        </p>
        <ul class="mt-8 space-y-4 text-small">
          <li class="flex gap-3">
            <Icon name="map-pin" size={20} class="mt-0.5 shrink-0 text-teal-300" />
            <span>{t.company.address.line1}<br />{t.company.address.line2}{comma}{t.company.address.country}</span>
          </li>
          <li>
            <a href={`mailto:${site.email}`} class="inline-flex min-h-11 items-center gap-3 hover:text-white">
              <Icon name="mail" size={20} class="text-teal-300" /><span dir="ltr">{site.email}</span>
            </a>
          </li>
          <li>
            <a href={telHref} class="inline-flex min-h-11 items-center gap-3 hover:text-white">
              <Icon name="phone" size={20} class="text-teal-300" /><span dir="ltr">{site.phone}</span>
            </a>
          </li>
        </ul>
      </div>

      <div class="grid grid-cols-1 gap-10 sm:grid-cols-3">
        {columns.map((col) => (
          <div>
            <h2 class="font-display text-small font-semibold uppercase tracking-[0.08em] text-white">{col.title}</h2>
            <ul class="mt-4 space-y-1">
              {col.links.map((link) => (
                <li>
                  <a href={l(link.href)} class="inline-flex min-h-10 items-center text-small transition-colors hover:text-white">
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>

    <div class="container flex flex-col gap-4 border-t border-white/10 py-8 text-[0.8125rem] text-white/55 md:flex-row md:items-center md:justify-between">
      <p>© {year} {t.company.legalName} (OUPCO). {f.rights} · <span dir="ltr">{site.cr}</span> · <span dir="ltr">{site.vat}</span></p>
      <div class="flex items-center gap-2">
        <span class="inline-flex items-center gap-2 rounded-full border border-white/15 px-3 py-1">
          <Icon name="flag" size={14} class="text-teal-300" /> {f.proud}
        </span>
      </div>
    </div>
  </div>
</footer>
