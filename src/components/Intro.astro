---
// First-visit intro: the logo's two arcs draw in, the wordmark slides in,
// then the panel lifts to reveal the hero. Pure CSS; a tiny inline script
// decides whether to play it (once per session, never for reduced motion).
// Without JS the intro never shows, so content is never blocked.
import { Image } from "astro:assets";
import logoDark from "../assets/brand/logo-dark.png";
---

<script is:inline>
  try {
    if (!matchMedia("(prefers-reduced-motion: reduce)").matches && !sessionStorage.getItem("oupco-intro")) {
      document.documentElement.classList.add("intro-play");
      sessionStorage.setItem("oupco-intro", "1");
    }
  } catch (e) {}
</script>

<div class="intro" aria-hidden="true">
  <div class="intro-brand" dir="ltr">
    <!-- letters "UPCO." (the image's own O is clipped away; the drawn mark becomes the O) -->
    <div class="intro-word">
      <Image src={logoDark} alt="" width={340} densities={[1, 2]} loading="eager" />
    </div>
    <svg viewBox="0 0 750 750" class="intro-mark">
      <g fill="none" stroke-width="111">
        <path class="intro-arc intro-arc-1" pathLength="1" d="M 515.893,170.065 A 255.310,255.310 0 1 0 497.537,590.480" stroke="#142e45" />
        <path class="intro-arc intro-arc-2" pathLength="1" d="M 529.742,566.649 A 255.310,255.310 0 0 0 545.898,196.612" stroke="#195e7f" />
      </g>
    </svg>
  </div>
  <div class="intro-line"></div>
</div>

<style is:global>
  /*
    Timeline (seconds)
    0.10–0.85  O draws in, centred and enlarged
    0.85–1.05  hold
    1.05–1.65  O glides into its place in the wordmark
    1.65–2.20  "UPCO." wipes in from behind the O
    2.20–2.50  hold on the full logo
    2.50–3.20  panel lifts, hero rises in
  */
  .intro { display: none; }

  html.intro-play .intro {
    position: fixed;
    inset: 0;
    z-index: 70;
    display: grid;
    place-items: center;
    background: #ffffff;
    animation: intro-lift 0.7s cubic-bezier(0.76, 0, 0.24, 1) 2.5s forwards;
  }
  html.intro-play body { overflow: hidden; animation: intro-unlock 0s linear 3s forwards; }


  /* Box with the wordmark's aspect ratio (1357 × 322) */
  .intro-brand { position: relative; width: min(340px, 72vw); aspect-ratio: 1357 / 322; }

  .intro-word { position: absolute; inset: 0; clip-path: inset(0 100% 0 22.2%); }
  .intro-word img { display: block; width: 100%; height: auto; }

  /* Mark sized/positioned to sit exactly on the wordmark's O
     (O = x 50–290, y 57–288 of 1357×322; ring = centre 362,374 r≈311 in the 750 box) */
  .intro-mark {
    position: absolute;
    left: 2.57%; top: 10.25%;
    width: 20.61%; height: 86.86%;
    overflow: visible;
    transform: translate(180.2%, -4.2%) scale(1.7);
  }
  .intro-arc { stroke-dasharray: 1; stroke-dashoffset: 1; }

  html.intro-play .intro-arc-1 { animation: intro-draw 0.65s cubic-bezier(0.65, 0, 0.35, 1) 0.1s forwards; }
  html.intro-play .intro-arc-2 { animation: intro-draw 0.45s cubic-bezier(0.65, 0, 0.35, 1) 0.4s forwards; }
  html.intro-play .intro-mark { animation: intro-settle 0.6s cubic-bezier(0.65, 0, 0.35, 1) 1.05s forwards; }
  html.intro-play .intro-word { animation: intro-letters 0.55s cubic-bezier(0.22, 1, 0.36, 1) 1.65s forwards; }

  .intro-line {
    position: absolute; left: 0; bottom: 0; height: 3px; width: 100%;
    background: var(--color-teal-600); transform: scaleX(0); transform-origin: left;
  }
  html.intro-play .intro-line { animation: intro-progress 2.4s cubic-bezier(0.65, 0, 0.35, 1) forwards; }

  /* Hero content rises in as the panel lifts */
  html.intro-play [data-intro-rise] {
    opacity: 0;
    transform: translateY(24px);
    animation: intro-rise 0.7s cubic-bezier(0.22, 1, 0.36, 1) forwards;
    animation-delay: calc(2.8s + var(--rise, 0) * 90ms);
  }
  html.intro-play #site-header { opacity: 0; animation: intro-fade 0.5s ease 2.95s forwards; }

  @keyframes intro-draw { to { stroke-dashoffset: 0; } }
  @keyframes intro-settle { to { transform: none; } }
  @keyframes intro-letters { to { clip-path: inset(0 0 0 22.2%); } }
  @keyframes intro-progress { to { transform: scaleX(1); } }
  @keyframes intro-lift { to { transform: translateY(-100%); visibility: hidden; } }
  @keyframes intro-rise { to { opacity: 1; transform: none; } }
  @keyframes intro-fade { to { opacity: 1; } }
  @keyframes intro-unlock { to { overflow: auto; } }

  @media (prefers-reduced-motion: reduce) {
    html.intro-play .intro { display: none; }
  }
</style>
