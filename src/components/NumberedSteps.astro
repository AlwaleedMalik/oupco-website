---
// Generic numbered process: horizontal rail on desktop, vertical list on mobile.
// Logical (start/end) positioning so the rail mirrors in RTL.
interface Props {
  steps: { title: string; text: string }[];
  tone?: "light" | "dark";
}
const { steps, tone = "light" } = Astro.props;
const dark = tone === "dark";
const cols = { 3: "lg:grid-cols-3", 4: "lg:grid-cols-4", 5: "lg:grid-cols-5" }[steps.length] ?? "lg:grid-cols-4";
---

<ol class:list={["grid gap-0 lg:gap-6", cols]}>
  {steps.map((s, i) => (
    <li class="relative grid grid-cols-[3rem_1fr] gap-x-4 pb-8 last:pb-0 lg:block lg:pb-0" data-reveal style={`--reveal-delay:${i * 70}ms`}>
      <span
        aria-hidden="true"
        class:list={[
          "absolute start-6 top-12 bottom-0 w-px lg:start-14 lg:-end-6 lg:top-6 lg:bottom-auto lg:h-px lg:w-auto",
          i === steps.length - 1 && "hidden",
          dark ? "bg-white/20" : "bg-line-strong",
        ]}
      />
      <span class:list={["relative z-10 flex size-12 items-center justify-center rounded-full font-display font-semibold", dark ? "bg-white text-navy-900" : "bg-navy-900 text-white"]}>
        {String(i + 1).padStart(2, "0")}
      </span>
      <div class="lg:mt-5">
        <h3 class:list={["text-h6", dark && "text-white"]}>{s.title}</h3>
        <p class:list={["mt-1.5 text-small", dark ? "text-white/70" : "text-muted"]}>{s.text}</p>
      </div>
    </li>
  ))}
</ol>
