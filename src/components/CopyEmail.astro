---
// Site-wide: clicking any mailto: link copies the address and shows a toast.
// Links keep their mailto: href, so without JS (or if copying is blocked) they still open the mail app.
import Icon from "./Icon.astro";
import { getT } from "../i18n";

const t = getT(Astro.url);
---

<div
  id="copy-toast"
  role="status"
  aria-live="polite"
  data-template={t.ui.copied}
  class="pointer-events-none fixed inset-x-0 bottom-6 z-[80] flex justify-center px-4 opacity-0 translate-y-3 transition-[opacity,transform] duration-200 ease-out-soft"
>
  <div class="inline-flex items-center gap-2.5 rounded-full bg-white px-4 py-2.5 text-small font-medium text-navy-900 shadow-[0_10px_40px_-8px_rgb(12_28_43/0.45)] ring-1 ring-navy-900/10">
    <span class="flex size-5 items-center justify-center rounded-full bg-success text-white"><Icon name="check" size={13} strokeWidth={3} /></span>
    <span data-toast-text dir="auto"></span>
  </div>
</div>

<script>
  const toast = document.getElementById("copy-toast")!;
  const text = toast.querySelector<HTMLElement>("[data-toast-text]")!;
  let timer: number | undefined;

  const show = (msg: string) => {
    text.textContent = msg;
    toast.classList.remove("opacity-0", "translate-y-3");
    clearTimeout(timer);
    timer = window.setTimeout(() => toast.classList.add("opacity-0", "translate-y-3"), 2000);
  };

  const copy = async (value: string) => {
    if (navigator.clipboard && window.isSecureContext) {
      await navigator.clipboard.writeText(value);
      return;
    }
    // Fallback for older browsers / non-HTTPS
    const ta = Object.assign(document.createElement("textarea"), { value });
    ta.setAttribute("readonly", "");
    ta.style.cssText = "position:fixed;opacity:0";
    document.body.appendChild(ta);
    ta.select();
    const ok = document.execCommand("copy");
    ta.remove();
    if (!ok) throw new Error("copy failed");
  };

  document.addEventListener("click", async (e) => {
    const a = (e.target as Element).closest<HTMLAnchorElement>('a[href^="mailto:"]');
    if (!a || e.metaKey || e.ctrlKey || e.shiftKey) return; // modifier-click = open mail app
    const email = decodeURIComponent(a.getAttribute("href")!.slice(7).split("?")[0]);
    e.preventDefault();
    try {
      await copy(email);
      show((toast.dataset.template ?? "{email}").replace("{email}", email));
    } catch {
      window.location.href = a.href; // couldn't copy → open the mail app instead
    }
  });
</script>

<style is:global>
  /* cue that email links copy rather than navigate */
  a[href^="mailto:"] { cursor: copy; }
</style>
