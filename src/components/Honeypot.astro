---
// Invisible to people and screen readers; bots tend to fill it in.
// Clipped in place (not pushed off-screen) so it never creates sideways scroll in RTL layouts.
---

<div aria-hidden="true" class="pointer-events-none absolute top-0 start-0 size-px overflow-hidden opacity-0 [clip-path:inset(50%)]">
  <label>Leave this field empty <input type="text" name="_hp" tabindex="-1" autocomplete="off" /></label>
</div>
