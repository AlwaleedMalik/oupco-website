---
// Inlines a Lucide icon at build time — zero runtime JS, no icon font.
import { readFileSync } from "node:fs";
import { createRequire } from "node:module";

const iconPath = (name: string) => createRequire(import.meta.url).resolve(`lucide-static/icons/${name}.svg`);

interface Props {
  name: string;
  class?: string;
  size?: number;
  strokeWidth?: number;
  label?: string;
}

const { name, class: className = "", size = 24, strokeWidth = 1.75, label } = Astro.props;

// Icons that point "forward" mirror on right-to-left pages
const directional = /^(arrow-(right|left|up-right|up-left|down-right|down-left)|chevron-(right|left)|send|log-in|log-out)$/.test(name);

const raw = readFileSync(iconPath(name), "utf8");
const inner = raw.replace(/<!--[\s\S]*?-->/, "").replace(/^[\s\S]*?<svg[^>]*>/, "").replace(/<\/svg>\s*$/, "");
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  class:list={[className, directional && "rtl:-scale-x-100"]}
  aria-hidden={label ? undefined : "true"}
  role={label ? "img" : undefined}
  aria-label={label}
  focusable="false"
  set:html={inner}
/>
