---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import CopyEmail from "../components/CopyEmail.astro";
import { site } from "../data/site";
import { en, ar, dirOf, getLang, getT, stripLang } from "../i18n";
import og from "../assets/brand/og.png";
import { getImage } from "astro:assets";

interface Props {
  title?: string;
  description?: string;
  overlayHeader?: boolean;
  noindex?: boolean;
}

const lang = getLang(Astro.url);
const t = getT(Astro.url);
const { title, description = t.meta.description, overlayHeader = false, noindex = false } = Astro.props;
const fullTitle = title ? `${title} | ${t.meta.titleSuffix}` : t.meta.defaultTitle;

// Alternate URLs for both languages (same page, other language)
const basePath = stripLang(Astro.url.pathname);
const enUrl = new URL(basePath, site.url).href;
const arUrl = new URL(basePath === "/" ? "/ar" : `/ar${basePath}`, site.url).href;
const canonical = lang === "ar" ? arUrl : enUrl;
const ogImage = await getImage({ src: og, width: 1200, format: "jpg", quality: 80 });

const orgSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "OUPCO",
  alternateName: [en.company.fullName, ar.company.legalName],
  legalName: en.company.legalName,
  foundingDate: site.founded,
  vatID: site.vatNumber,
  identifier: { "@type": "PropertyValue", propertyID: "CR", value: site.crNumber },
  url: site.url,
  email: site.email,
  telephone: site.phone.replace(/\s/g, ""),
  address: {
    "@type": "PostalAddress",
    streetAddress: en.company.address.line1,
    addressLocality: "Riyadh",
    postalCode: "12486",
    addressCountry: "SA",
  },
};
---

<!doctype html>
<html lang={lang} dir={dirOf(lang)}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex ? (
      <meta name="robots" content="noindex" />
    ) : (
      <>
        <link rel="canonical" href={canonical} />
        <link rel="alternate" hreflang="en" href={enUrl} />
        <link rel="alternate" hreflang="ar" href={arUrl} />
        <link rel="alternate" hreflang="x-default" href={enUrl} />
      </>
    )}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#142e45" />

    <!--
      Language auto-detect (first visit only): an Arabic-language browser landing on an
      English page is sent to the Arabic version. An explicit choice (language switch,
      or opening a page in a given language) is remembered and always wins.
    -->
    <script is:inline>
      (function () {
        try {
          var p = location.pathname, onAr = /^\/ar(\/|$)/.test(p), key = "oupco-lang", pref = localStorage.getItem(key);
          if (pref) return;
          var bot = /bot|crawl|spider|slurp|lighthouse/i.test(navigator.userAgent) || navigator.webdriver;
          var primary = (navigator.languages && navigator.languages[0]) || navigator.language || "";
          var wantsAr = /^ar\b/i.test(primary);
          if (!onAr && wantsAr && !bot) {
            localStorage.setItem(key, "ar");
            location.replace("/ar" + (p === "/" ? "" : p) + location.search + location.hash);
            return;
          }
          localStorage.setItem(key, onAr ? "ar" : "en");
        } catch (e) {}
      })();
      document.documentElement.classList.add("js");
    </script>

    {lang === "ar" && <link rel="preload" href="/fonts/readex-pro-arabic.woff2" as="font" type="font/woff2" crossorigin />}
    <link rel="preload" href="/fonts/lexend.woff2" as="font" type="font/woff2" crossorigin />
    {lang === "en" && <link rel="preload" href="/fonts/source-sans-3.woff2" as="font" type="font/woff2" crossorigin />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="OUPCO" />
    <meta property="og:locale" content={t.meta.locale} />
    <meta property="og:locale:alternate" content={lang === "ar" ? en.meta.locale : ar.meta.locale} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(ogImage.src, site.url).href} />
    <meta name="twitter:card" content="summary_large_image" />

    <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
    <slot name="head" />
  </head>
  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:start-4 focus:top-4 focus:z-[60] focus:rounded-lg focus:bg-navy-900 focus:px-4 focus:py-3 focus:text-white"
    >{t.ui.skip}</a>
    <Header overlay={overlayHeader} />
    <main id="main" class:list={[!overlayHeader && "pt-18"]}>
      <slot />
    </main>
    <Footer />
    <CopyEmail />

    <script>
      // Scroll reveal: progressive enhancement, ~0.3 kB
      const els = document.querySelectorAll<HTMLElement>("[data-reveal]");
      if ("IntersectionObserver" in window && !matchMedia("(prefers-reduced-motion: reduce)").matches) {
        const io = new IntersectionObserver(
          (entries) => entries.forEach((e) => {
            if (e.isIntersecting) { e.target.classList.add("is-visible"); io.unobserve(e.target); }
          }),
          { rootMargin: "0px 0px -8% 0px" }
        );
        els.forEach((el) => io.observe(el));
      } else {
        els.forEach((el) => el.classList.add("is-visible"));
      }
    </script>
  </body>
</html>
