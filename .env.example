# Copy to .env and fill in (Supabase → Project Settings → API).
# Use the "publishable" key (sb_publishable_…) or, on older projects, the "anon" key. Both are public by design;
# Row Level Security limits them to INSERT on the three form tables. NEVER use the secret / service_role key here.
PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key
